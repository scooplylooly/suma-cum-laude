<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" type="text/css" href="./style/reset-form.css">
</head>

    <header>
        <h1>Placeholder Title</h1>
        <nav>
            <a href="/index.html">Home</a>
            <a href="/register">Register</a>
            <a href="/login">Login</a>
        </nav>
    </header>

<body>
    <main class="reset-page">
        <div class="reset-card">
            <h3>Key in your details to reset your password</h3>
            <form action="/forget-password" method="post" class="reset-form">
                Username: <input type="text" name="userName" value="<%= userName %>"> <br>
                Email: <input type="email" name="email" value="<%= email %>"> <br>
                <button type="submit">Get OTP</button>
            </form>

            <% if (errors.length > 0){ %>
            <ul class="error-list" class="error-list">
                <% errors.forEach(error => { %>
                    <li><%- error %></li>
            <% }) %>
            </ul>
        <% }; %>
            <% if (success) { %>
            <p class="success-message">
            Sending OTP to email: <%= email %>. <br>
            Dedirecting to login...
            </p>
            <script>
                setTimeout(() => {
                    window.location.href = "/verify-otp";
                },1000)
            </script>
        <% } %>

        </div>
    </main>

    <script>
        function togglePassword(passwordField) {
        const input = document.getElementById(passwordField);
        const icon = document.getElementById(passwordField + '-icon')

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        }
    }

    </script>
    <%- include('common/footer') %>
</body>
</html>