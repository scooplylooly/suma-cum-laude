<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= details.userName %>'s profile</title>
    <link rel="stylesheet" type="text/css" href="./style/user-profile.css" />
</head>
<!--renders user profile page with relevant details retrieved from database-->
<body>
    <%- include('common/header') %>
    
    <main class="profile-page">
            <%if(details.role == 'admin'){%>
            <h2>Hi <%=details.userName%>!</h2>
            <%}else{%>
            <h2>Hi <%=details.userName%>!</h2>
            <%}%>
            <p>Edit your profile information over here at anytime!</p>
        <div class="profile-card">
            <h4>Here are your details:</h4>
            <div class="profile-deets">
            <div class="detail-box">
                <strong><span class="label">Name: </span></strong>
                <span class="value"><%= details.userName %></span>
            </div>

            <div class="detail-box">
                <strong> <span class="label">Email: </span></strong>
                <span class="value"><%= details.email %></span>
            </div>

            <div class="detail-box">
                <strong><span class="label">Date of Birth: </span></strong>
                <span class="value"><%= details.DOB.split('-').reverse().join('/') %></span>
            </div>

            <div class="detail-box">
                <strong><span class="label">Security Question: What is your dream pet? </span></strong>
                <span class="value"><%= details.securityKey %></span>
            </div>

        </div>
            <!--users can redirect to edit-profile details, preferences, logout or delete profile pages-->
            <div class="actions">
                <a href="/edit-profile" class="edit-button">Edit details</a>
                <a href="/preferences" class="edit-button">Set Preferences</a>   
                <a href="/logout" class="logout-button">Log out</a>
                <a href="/delete-profile" class="delete-button">Delete Account</a>  
                <%if(details.role == 'lister'){%>
                    <%if(listerApplication && listerApplication.statusL == 'approved'){%>                    <h3 style="color: green;">You're a registered <b>Lister</b>!</h3>
                    <p>As a lister, you can create pet listings and manage them on your profile page.</p> 
                    <a href="/update-lister-profile" class="edit-button">Edit Lister details</a>
                    <a href="/delete-lister-profile" class="delete-button">Delete Lister profile</a>  
                    <%}%>
                <%}else if (details.role == 'user'){%> <!--if user is not lister, will show tab for them to apply to be lister-->
                    <h3>Interested in listing pets?</h3>
                    <p>As a lister, you can create pet listings and manage them on your profile page.</p>
                    <%if(listerApplication){%>
                        <%if(listerApplication.statusL == 'pending'){%> <!--if user has pending listing applications, status is shown and they can update their application too-->
                            <p>Check your application status down here & edit your details at any time.</p>
                            <a href="/update-lister-profile" class="edit-button">Edit Lister details</a>
                    
                        <%}else if(listerApplication.statusL == 'rejected'){%> <!--shows rejected status if user's application was rejected-->
                            <h3>Your lister application was rejected.</h3>
                            <p>You can reapply after some time.</p>
                        <%}%>
                        <a href="/lister-application-status" class="edit-button">Application status</a>   
                    <%}else{%>
                        <p>Apply to become a lister now to start listing pets for adoption!</p>
                        <a href="/apply-lister" class="edit-button">Apply lister</a>
                    <%}%> 

                <%}%>
            </div>
        </div>
            

    </main>
    <%- include('common/footer') %>
</body>
</html>