<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= details.userName %>'s profile</title>
    <link rel="stylesheet" type="text/css" href="./style/user-profile.css" />
</head>

<body>
    <%- include('common/header') %>
    
    <main class="profile-page">
            <%if(user.role == 'admin'){%>
            <h2>Hi <%=user.userName%>!</h2>
            <%}else{%>
            <h2>Hi <%=user.userName%>!</h2>
            <%}%>
            <p>Edit your profile information over here at anytime!</p>
        <div class="profile-card">
            <h4>Here are your details:</h4>
            <div class="profile-deets">
            <div class="detail-box">
                <strong><span class="label">Name: </span></strong>
                <span class="value"><%= details.userName %></span>
            </div>

            <div class="detail-box">
                <strong> <span class="label">Email: </span></strong>
                <span class="value"><%= details.email %></span>
            </div>

            <div class="detail-box">
                <strong><span class="label">Date of Birth: </span></strong>
                <span class="value"><%= details.DOB.split('-').reverse().join('/') %></span>
            </div>

            <div class="detail-box">
                <strong><span class="label">Security Question: What is your dream pet? </span></strong>
                <span class="value"><%= details.securityKey %></span>
            </div>

        </div>

            <div class="actions">
                <a href="/edit-profile" class="edit-button">Edit details</a>
                <a href="/preferences" class="edit-button">Set Preferences</a>   
                <a href="/delete-profile" class="delete-button">Delete Account</a>
                <a href="/logout" class="logout-button">Log out</a>
            </div>
        </div>
    </main>
    <%- include('common/footer') %>
</body>
</html>