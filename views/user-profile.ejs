<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= details.userName %>'s profile</title>
    <link rel="stylesheet" type="text/css" href="./style/user-profile.css" />
</head>

<body>
    <%- include('common/header') %>
    
    <main class="profile-page">
            <%if(user.role == 'admin'){%>
            <h2>Hi <%=user.userName%>!</h2>
            <%}else{%>
            <h2>Hi <%=user.userName%>!</h2>
            <%}%>
            <p>Edit your profile information over here at anytime!</p>
        <div class="profile-card">
            <h4>Here are your details:</h4>
            <div class="profile-deets">
            <div class="detail-box">
                <strong><span class="label">Name: </span></strong>
                <span class="value"><%= details.userName %></span>
            </div>

            <div class="detail-box">
                <strong> <span class="label">Email: </span></strong>
                <span class="value"><%= details.email %></span>
            </div>

            <div class="detail-box">
                <strong><span class="label">Date of Birth: </span></strong>
                <span class="value"><%= details.DOB.split('-').reverse().join('/') %></span>
            </div>

            <div class="detail-box">
                <strong><span class="label">Security Question: What is your dream pet? </span></strong>
                <span class="value"><%= details.securityKey %></span>
            </div>

        </div>

            <div class="actions">
                <a href="/edit-profile">Edit details</a>
                <a href="/apply-lister">Apply lister</a>
                <a href="/logout" class="button3">Log out</a>
                <a href="/delete-profile" class="delete">Delete Account</a>  
                <%if(user.role =='lister'){%>
                    <a href="/delete-lister" class="delete">Delete Lister</a>  
                <%}%>
            </div>
        </div>
        
           <%if(user.role == 'lister'){%>
            Create your pet listings <a href="/pet-create-listings">here!</a><br><br>
            Update your pet details <a href="/update-pet-details">here!</a><br><br>
            Update your own lister details <a href="/update-lister-profile">here!</a><br><br>
            <%}else{%>
            <h3>Do you want to list some pets?</h3>
            <p>
                Have you already applied? Check your application status <a href="/lister-application-status">here</a>.
            </p>
            <p>
                If not, click <a href="/apply-lister">here</a> to apply!
            </p>
            <%}%>

    </main>
    <%- include('common/footer') %>
</body>
</html>