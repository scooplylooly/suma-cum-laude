<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= details.userName %>'s profile</title>
    <link rel="stylesheet" type="text/css" href="./style/profile.css" />
</head>

<body>
    <%- include('common/header') %>
    
    <main class="profile-page">
        <div>
            <%if(user.role == 'admin'){%>
            <h2>Admin: <%= details.userName %></h2> <br>
            <%}else{%>
            <h2>User: <%= details.userName %></h2> <br>
            <%}%>
            
            <h4>Your details</h4>
            <div class="profile-deets">
                <div class="box"><%= details.email %></div> <br>
                <div class="box"><%= details.DOB.split('-').reverse().join('/') %></div> <br>
            </div>
            <div class="actions">
                <a href="/edit-profile">Edit details</a>
                <a href="/delete-profile" class="delete">Delete Account</a>
            </div>
        </div>
        <div>

            <%if (isLoggedInL){%>
            Create your pet listings <a href="/pet-create-listings">here</a>!
            Update your pet details <a href="/update-pet-details">here</a>!
            <%}else{%>
            <h3>Do you want to list some pets?</h3>
            <p>
                <a href="/login-lister">Log in</a> to start listing!
            </p>
            <p>
                Have you already applied? Check your application status here:
            </p>
            <p>
                If not, click <a href="/apply-lister">here</a> to apply!
            </p>
            <%}%>
            
        </div>
    </main>
    <%- include('common/footer') %>
</body>
</html>