<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= details.userName %>'s profile</title>
    <link rel="stylesheet" type="text/css" href="./style/profile.css" />
</head>

<body>
    <%- include('common/header') %>
    
    <main class="profile-page">
            <%if(user.role == 'admin'){%>
            <h2>Admin: <%= details.userName %></h2> <br>
            <%}else{%>
            <h2>User: <%= details.userName %></h2> <br>
            <%}%>
        <div class="profile-card">
            <p class="subtitle">Here are your details.</p>
            <div class="profile-deets">
            <div class="detail-box">
                <span class="label">Name: </span>
                <span class="value"><%= details.userName %></span>
            </div>

            <div class="detail-box">
                <span class="label">Email: </span>
                <span class="value"><%= details.email %></span>
            </div>

            <div class="detail-box">
                <span class="label">Date of Birth: </span>
                <span class="value"><%= details.DOB.split('-').reverse().join('/') %></span>
            </div>
        </div>

            <div class="actions">
                <a href="/edit-profile" class="button1">Edit details</a>
                <a href="/delete-profile" class="button2">Delete Account</a>
                <a href="/logout" class="button3">Log out</a>
            </div>
        </div>
    </main>
    <%- include('common/footer') %>
</body>
</html>