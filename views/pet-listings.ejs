<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <h2>Adoption Listings</h2>
        <% for(let pet of pets){%>
        <form action="/pet-profile" method="post">
            <img src="/images/<%=pet.img %>.jpg" style="width: 150px; height: 150px; object-fit: cover; border-radius: 10px;" alt="<%= pet.Name%>">
            <h4><%=pet.name%></h4>
            <h5>Breed: <%=pet.breed[0].toUpperCase() + pet.breed.slice(1)%></h5>
            <h5>Date Of Birth: <%=pet.dob%></h5>
            <input type="hidden" name="uid" value="<%= result.isbn %>">
            <button type="submit" name="petName" value="<%=pet.name%>">View Applications</button>
        </form><br>     
      <%}%>
</body>
</html>