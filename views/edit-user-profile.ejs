<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.userName %>'s</title>
    <link rel="stylesheet" type="text/css" href="./style/edit-profile.css">
</head>
<body>
    <%- include('common/header') %>
    <main class="edit-page">
        <div id="form" class="edit-card">
            <form action="/edit-profile" class="edit-form" method="post">
                <h2>Please update your details.</h2>
                Username: <input type="text" name="userName" value="<%= originalDetails.userName %>"> <br>
                Email: <input type="text" name="email" value="<%= originalDetails.email %>"> <br>
                DOB: <input type="date" name="dob" value="<%= originalDetails.DOB %>"> <br>
                Update Password: <input type="password" name="password" value="<%= password %>"> <br>
                Confirm Password: <input type="password" name="password2" value="<%= password2 %>"> <br>
                <button type="submit">Update</button>
            </form>
        </div>
    </main>
    <%- include('common/footer') %>
</body>
</html>