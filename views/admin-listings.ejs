<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listing Management</title>
    <link rel="stylesheet" href="/style/admin-listings.css">
</head>
<body>
    <%- include('common/header') %>

    <main class="admin-listings-page">
        <section class="page-hero">
            <h2>Admin - Pet Listings</h2>
            <p>Review, filter, and manage all pet listings in one place.</p>
        </section>

        <div class="top-actions">
            <a href="/create-listing" class="top-link">
                <button type="button">Create Listing for User</button>
            </a>
        </div>

        <form action="/admin/listings" method="post" class="filter-form">
            <label for="status">Pick a Status:</label>
            <select name="status" id="status">
                <option value="" <%= selectedStatus === "" ? "selected" : "" %>>All</option>
                <option value="pending" <%= selectedStatus === "pending" ? "selected" : "" %>>Pending</option>
                <option value="approved" <%= selectedStatus === "approved" ? "selected" : "" %>>Approved</option>
            </select>
            <button type="submit">Filter</button>
        </form>

        <% if (pets.length < 1) { %>
            <h4 class="empty-state">No listings found.</h4>
        <% } else { %>
            <h3>
                <%= selectedStatus === "pending" ? "Pending" : selectedStatus === "approved" ? "Approved" : "All" %> Listings
            </h3>

            <div class="container-flex">
                <% for (let listing of pets) { %>
                    <div class="item">
                        <img src="/images/<%= listing.img %>.jpg" alt="<%= listing.name %>">

                        <h4><%= listing.name %></h4>

                        <!-- subtitle -->
                        <p class="pet-id"><%= listing._id%></p>

                        <p><span>Breed:</span> <%= listing.breed[0].toUpperCase() + listing.breed.slice(1) %></p>
                        <p><span>Date Of Birth:</span> <%= listing.dob %></p>

                        <!-- same line -->
                        <div class="status-row">
                            <% if (!listing.approved) { %>
                                <span class="status pending">Pending</span>
                            <% } else { %>
                                <span class="status approved">Approved</span>
                            <% } %>

                            <% if (listing.adopted) { %>
                                <span class="status adopted">Adopted</span>
                            <% } %>
                        </div>

                        <div class="card-actions">
                            <a href="/admin/change-listings-status?pid=<%= listing._id %>">
                                <button type="button">Update Status</button>
                            </a>
                            <a href="/update-pet?pid=<%= listing._id %>">
                                <button type="button">Update Listing</button>
                            </a>
                            <a href="/delete-pet?pid=<%= listing._id %>">
                                <button type="button" class="danger">Delete Listing</button>
                            </a>
                            <a href="/view-applications?pid=<%=listing._id%>">
                                <button type="button">View Applications</button>
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </main>

    <%- include('common/footer') %>
</body>
</html>