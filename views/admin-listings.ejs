<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Incoming Listings</title>
</head>
<body>
    <%- include('common/header') %>
    <h2>Admin - Pet Listings</h2>
    <a href="/create-listing"><button>Create Listing</button></a><br>

    <form action="/admin-listings" method="post">
      Pick a Status:
      <select name="status">
        <option value="" <%= selectedStatus === "" ? "selected" : "" %>>All</option>
        <option value="pending" <%= selectedStatus === "pending" ? "selected" : "" %>>Pending</option>
        <option value="approved" <%= selectedStatus === "approved" ? "selected" : "" %>>Approved</option>
      </select>
      <button type="submit">Filter</button>
    </form>
    <% if (pets.length < 1) { %>
        <h4>No listings found.</h4>
    <% } else { %>
        <h3><%= selectedStatus === "pending" ? "Pending" : selectedStatus === "approved" ? "Approved" : "All" %> Listings</h3>
        
        <div class="container-flex">
        <% for (let listing of pets) { %>
            <% if(!listing.approved){ %>
            <div class="item">
                <img src="/images/<%=listing.img %>.jpg" style="width: 150px; height: 150px; object-fit: cover; border-radius: 10px;" alt="<%= listing.Name%>">
                <h4><%= listing.name %></h4>
                <p>Breed: <%= listing.breed[0].toUpperCase() + listing.breed.slice(1) %></p>
                <p>Date Of Birth: <%= listing.dob %></p>
                <p style="color: red;">Status: Pending</p>
                <a href="/admin-change-listings-status?pid=<%= listing._id %>"><button>Update Status</button></a>
                <a href="/update-pet?pid=<%= listing._id %>"><button>Update Listing</button></a>
                <a href="/delete-pet?pid=<%= listing._id %>"><button>Delete Listing</button></a>
            </div>
            <% } else { %>
            <div class="item">
                <img src="/images/<%=listing.img %>.jpg" style="width: 150px; height: 150px; object-fit: cover; border-radius: 10px;" alt="<%= listing.Name%>">
                <h4><%= listing.name %></h4>
                <p>Breed: <%= listing.breed[0].toUpperCase() + listing.breed.slice(1) %></p>
                <p>Date Of Birth: <%= listing.dob %></p>
                <p style="color: green;">Status: Approved</p>
                <a href="/admin-change-listings-status?pid=<%= listing._id %>"><button>Update Status</button></a>
                <a href="/update-pet?pid=<%= listing._id %>"><button>Update Listing</button></a>
                <a href="/delete-pet?pid=<%= listing._id %>"><button>Delete Listing</button></a>
            </div>
            <% } %>
        <% } %>
        </div>
    <% } %>
    <%- include('common/footer') %>
</body>
</html>