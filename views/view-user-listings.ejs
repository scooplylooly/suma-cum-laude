<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View your Listings</title>
</head>
<body>
    <%- include('common/header') %>
     <h2>Your Listings</h2>
        <% for(let pet of petFound){%>
        <img src="/images/<%=pet.img %>.jpg" style="width: 150px; height: 150px; object-fit: cover; border-radius: 10px;" alt="<%= pet.Name%>">
        <h4><%=pet.name%></h4>
        <h5>Breed: <%=pet.breed[0].toUpperCase() + pet.breed.slice(1)%></h5>
        <h5>Date Of Birth: <%=pet.dob%></h5>
        <a href="/edit-listing?pid=<%=pet._id%>"><button>Make <b>changes</b> to listing</button></a>
        <a href="/"><button>View Applications</button></a>
        <br><br>
      <%}%>
</body>
</html>