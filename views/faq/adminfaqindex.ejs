
<!-- Manage FAQs Page, allows admin to manage frequently asked questions -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage FAQs</title>
    <link rel="stylesheet" type="text/css" href="/style/faqindex.css">
</head>
<body>
    <%- include("../common/header") %>

    <main>
        <div class="admin-header">
            <h1>Manage Frequently Asked Questions</h1>
            <a href="/admin/faq/new" class="btn-add">Add FAQ</a>
        </div>
        <section class="faq-container">
            <% faqs.forEach(faq => { %>
                <article class="faq-card">
                    <h3 class="faq-question"><%= faq.question %></h3>
                    <p class="faq-answer"><%= faq.answer %></p>
                    <div class="admin-actions">
                        <a href="/admin/faq/edit?id=<%= faq._id %>" class="btn-edit">Edit</a>
                        <form action="/admin/faq/delete" method="post" onsubmit="return confirm('Delete this FAQ permanently?')">
                            <input type="hidden" name="id" value="<%= faq._id %>">
                            <button type="submit" class="delete-btn">Delete FAQ</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </section>
    </main>
</body>
</html>