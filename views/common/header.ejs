<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" type="text/css" href="./style/index.css" />
    </head>
    <body>
        <header>
            <h1>web name</h1>
            <nav>
                <a href="/">Home</a>
                <!--if user session does not exist, nav bar shows this-->
                <% if(!user){ %> 
                    <a href="/register">Register</a>
                    <a href="/login">Log in</a>
                
                <!--else other functions in nav bar-->
                <%}else{%>
                    <a href="/adopt">Search Listings</a>
                    <a href="">Application Status</a>
                    <a href="/view-listings">View Your Listings</a>
                    <a href="/profile">Account</a>
                    <a href="/logout">Log out</a>
                <% if (user._id.toString() === '69c0095e226ed8af0fa8d239'){ %>
                    <a href="/admin-page">Admin Page</a>
                <% } %>
                <%}%>
            </nav>
        </header>
    </body>
</html>