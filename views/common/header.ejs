<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" type="text/css" href="/style/index.css" />
    </head>
    <body>
        <header>
            <h1>WeADopt</h1>
            <nav>
                <a href="/adopt">Home</a>
                <!--if user session does not exist, nav bar shows this-->
                <% if(!user){ %> 
                    <a href="/register">Register</a>
                    <a href="/login">Log in</a>
                <!--else other functions in nav bar-->
               
                <%}else{%>
                    <a href="/application-status">Application Status</a>
                    <a href="/profile">Profile</a>
                    <a href="/faq">FAQ</a>
                <%}%>
                 <% if (user.role == 'lister'||user.role == 'admin'){%>
                    <a href="/view-listings">My Listed Pets</a>
                <%}%>
                <%if(user.role == 'admin'){%>
                    <a href="/admin-page">Admin page</a>
                <%}%>
            </nav>
        </header>
    </body>
</html>