<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Pet Listing</title>
</head>
<body>
    <h2>Pet Listing Creation</h2>
    <p>Fill in the form to list your foster in our website!</p>
    <br>
    <form action="/create-listing" method="post" enctype="multipart/form-data">
        
        <label for="type_input">Type of Pet: </label>
        <select id="type_input" name="type">
            <option value="dog">Dog</option>
            <option value="cat">Cat</option>
            <option value="guinea pig">Guinea pig</option>
            <option value="bird">Bird</option>
            <option value="rabbit">Rabbit</option>
            <option value="hamster">Hamster</option>
        </select><br><br>
        <label for="imgToUpload">Select image to upload:</label><input type="file" id="imgToUpload" name="image" accept="image/*"><br><br>
        <label for="name_input">Name of Pet: </label><input type="text" id="name_input" name="name"><br><br>
        <label for="breed_input">Breed of Pet: </label><input type="text" id="breed_input" name="breed"><br><br>
        <label for="gender_input">Gender: </label><input type="radio" name="gender" value="male" id="gender_input"> Male <input type="radio" name="gender" value="female" id="gender_input"> female <br><br>
        <label for="desc_input">Description: </label><br><br><textarea cols="30" rows="5" name="desc" id="desc_input"></textarea><br><br>
        <label for="age_input">Age of Pet: </label><input type="text" id="age_input" name="age"><br><br>
        <label for="hdb_input">HDB Approved? </label><input type="radio" name="hdbApproved" value="yes" id="hdb_input"> Male <input type="radio" name="hdbApproved" value="no" id="hdb_input""> No <br><br>
        <label for="vac_input">Vaccinated? </label><input type="radio" name="vaccinated" value="yes" id="vac_input"> Male <input type="radio" name="vaccinated" value="no" id="vac_input""> No <br><br>
        <label for="ster_input">Sterilized? </label><input type="radio" name="Sterilized" value="yes" id="ster_input"> Male <input type="radio" name="Sterilized" value="no" id="ster_input""> No <br><br>
        <button type="submit">Submit</button>
    </form>
    <% if (errorMsg){ %>
        <h3 style="color: red;"><%=errorMsg%></h3>
    <%}%>
    <% if (successMsg){ %>
        <h3 style="color: green;"><%=successMsg%></h3>
    <%}%>

</body>
</html>