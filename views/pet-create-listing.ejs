<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Pet Listing</title>
    <link rel="stylesheet" href="/style/create-listing.css">
</head>
<body>
    <%- include('common/header') %>

    <main class="create-listing-page">
        <section class="page-hero">
            <h2>Pet Listing Creation</h2>
            <p>Fill in the form to list your foster on our website.</p>
        </section>

        <form action="/create-listing" method="post" enctype="multipart/form-data" class="listing-form">
            <%if (user.role === "admin"){%>
            <div class="form-group">
                <h3>Creating listing as Admin</h3>
                <p>Leave "Owner's user name" field empty to create listing for yourself!</p>
                <label for="ownerName_input">Owner's user name:</label>
                <input type="text" id="ownerName_input" name="ownerName">
            </div>
            <%}%>
            <div class="form-group">
                <label for="type_input">Type of Pet:</label>
                <select id="type_input" name="type">
                    <option hidden>--Choose a type--</option>
                    <option value="dog">Dog</option>
                    <option value="cat">Cat</option>
                    <option value="guinea pig">Guinea pig</option>
                    <option value="bird">Bird</option>
                    <option value="rabbit">Rabbit</option>
                    <option value="hamster">Hamster</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div class="form-group">
                <label for="imgToUpload">Select image to upload:</label>
                <input type="file" id="imgToUpload" name="image" accept="image/*" required>
            </div>

            <div class="form-group">
                <label for="name_input">Name:</label>
                <input type="text" id="name_input" name="name">
            </div>

            <div class="form-group">
                <label for="breed_input">Breed:</label>
                <input type="text" id="breed_input" name="breed">
            </div>

            <div class="form-group">
                <label>Gender:</label>
                <div class="radio-group">
                    <label class="choice"><input type="radio" name="gender" value="male"> Male</label>
                    <label class="choice"><input type="radio" name="gender" value="female"> Female</label>
                </div>
            </div>

            <div class="form-group">
                <label>How's their personality?</label>
                <div class="checkbox-group">
                    <% for (let per of petPersonalities) { %>
                        <label class="choice">
                            <input type="checkbox" name="personality" value="<%= per %>">
                            <%= per[0].toUpperCase() + per.slice(1) %>
                        </label>
                    <% } %>
                </div>
            </div>

            <div class="form-group">
                <label for="desc_input">Description:</label>
                <textarea cols="30" rows="5" name="desc" id="desc_input"></textarea>
            </div>

            <div class="form-group">
                <label for="dob_input">Date of Birth:</label>
                <input type="date" id="dob_input" name="dob">
            </div>

            <div class="form-group">
                <label>HDB Approved?</label>
                <div class="radio-group">
                    <label class="choice"><input type="radio" name="hdbApproved" value="true"> Yes</label>
                    <label class="choice"><input type="radio" name="hdbApproved" value="false"> No</label>
                </div>
            </div>

            <div class="form-group">
                <label>Vaccinated?</label>
                <div class="radio-group">
                    <label class="choice"><input type="radio" name="vaccinated" value="true"> Yes</label>
                    <label class="choice"><input type="radio" name="vaccinated" value="false"> No</label>
                </div>
            </div>

            <div class="form-group">
                <label>Sterilized?</label>
                <div class="radio-group">
                    <label class="choice"><input type="radio" name="sterilized" value="true"> Yes</label>
                    <label class="choice"><input type="radio" name="sterilized" value="false"> No</label>
                </div>
            </div>

             <div class="form-group">
                <label>Activity Level of pet:</label>
                <div class="radio-group">
                    <label class="choice"><input type="radio" name="activityLevel" value="low"> Low</label>
                    <label class="choice"><input type="radio" name="activityLevel" value="medium"> Medium</label>
                    <label class="choice"><input type="radio" name="activityLevel" value="high"> High</label>
                </div>
            </div>
             <div class="form-group">
                <label>Experience Level needed?</label>
                <div class="radio-group">
                    <label class="choice"><input type="radio" name="experienceLevel" value="beginner"> Beginner</label>
                    <label class="choice"><input type="radio" name="experienceLevel" value="intermediate"> Intermediate</label>
                    <label class="choice"><input type="radio" name="experienceLevel" value="experienced"> Experienced</label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit">Submit</button>
            </div>
        </form>

        <% if (errorMsg) { %>
            <h3 class="message error"><%= errorMsg %></h3>
        <% } %>

        <% if (successMsg) { %>
            <h3 class="message success"><%= successMsg %> Redirecting to listings...</h3>
            <script>
                setTimeout(() => {
                    location.href = "/view-listings";
                }, 3000)
            </script>
        <% } %>
    </main>

    <%- include('common/footer') %>
</body>
</html>