<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Admin Page</title>
        <link rel="stylesheet" type="text/css" href="/style/admin-page.css" />
    </head>
    <body>
        <%- include('common/header') %>

        <main class="admin-page">
            <section class="admin-hero">
                <h2>Admin Page</h2>
                <p>
                    Welcome to the admin page. Here you can manage users,
                    listings, FAQs and applications.
                </p>
            </section>

            <!-- Admin functionalities can be added here -->
            <section class="admin-grid">
                <div class="admin-card">
                    <a href="/admin/listings">
                        <button>Manage Listings</button>
                    </a>
                    <p>
                        Review, approve, reject, edit, or delete pet listings.
                    </p>
                </div>
                <!-- listings are those that are pending approval/approved from admin, 
            and will be displayed in the order they were created (oldest to newest) 
            for admin to review and approve/reject listings. can edit and delete them too-->

                <div class="admin-card">
                    <a href="/admin/users">
                        <button>Manage Users</button>
                    </a>
                    <p>
                        View user information and update or remove accounts if
                        needed.
                    </p>
                </div>
                <!-- will see all users info in the db and can edit/delete users if needed -->

                <div class="admin-card">
                    <a href="/admin/listers">
                        <button>Manage Listers</button>
                    </a>
                    <p>
                        Approve or reject users who applied to become listers.
                    </p>
                </div>
                <!-- will see all listers that have applied to be listers and can approve/reject them -->

                <div class="admin-card">
                    <a href="/admin/faq">
                        <button>Manage FAQ</button>
                    </a>
                    <p>
                        Review get questions from users, approve and answer them
                        and it will be posted in FAQs
                    </p>
                </div>
                <!-- will see all meet-ups that have been scheduled by users and can approve/reject them. can edit and delete them too-->
            </section>
        </main>
       <section class="admin-section">
            <h2>Dashboard</h2>
            <table class="admin-stats-table">
                <tr>
                    <th>Total Pets</th>
                    <th>Total Applications</th>
                    <th>Pending Applications</th>
                    <th>Total FAQs</th>
                    <th>Total Users</th>
                </tr>
                <tr>
                    <td><%= totalPets %></td>
                    <td><%= totalApplications %></td>
                    <td><%= pendingApplications %></td>
                    <td><%= totalFaqs %></td>
                    <td><%= totalUsers %></td>
                </tr>
            </table>

            <div class="pet-type-list">
                <h3>Top Pet Types</h3>  
                <%if (topPetTypes.length > 0){%>
                    <p>Most applied for pet types based on applications.</p>
                <% for (let entry of topPetTypes) { %>
                    <div class="pet-type-item">
                        <div class="pet-type-label">
                            <span><%= entry.type %></span>
                            <span><%= Math.round((entry.count / totalApplications) * 100) %>%</span>
                        </div>
                        <div class="pet-type-bar">
                            <div
                                class="pet-type-fill"
                                style="width: <%= Math.round((entry.count / totalApplications) * 100) %>%;">
                            </div>
                    </div>
                    </div>
                
                <%}%>
                </div>
                <%}else{%>
                    <p>No pet types available.</p>
                <% } %>
            </div>
        </section>

        <section class="admin-section">
            <h2>Quick Actions</h2>
            <div class="quick-actions">
                <a href="/admin/listings">Manage Listings</a>
                <a href="/admin/faq">Manage FAQs</a>
                <a href="/admin/users">Manage Users</a>
                <a href="/admin/listers">Manage Listers</a>
            </div>
        </section>

        <%- include('common/footer') %>
    </body>
</html>
