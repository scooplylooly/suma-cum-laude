<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('common/header') %>

    <h2>Pet Profile</h2>
    <div>
        <%Object.keys(petFound).forEach(key => {%>
        <% if (key != 'type' && key != 'uid' && key != 'pid'){%>
        <% if(key == "img") {%>
            <img src="/images/<%=petFound[key] %>.jpg" style="width: 20;height: 20; border-radius: 10%;">
        <%}else if (key == "Name"){%>
            <h2><%= petFound[key] %></h2>
        <%}else if (key == "dob"){%>
            <h4>Date of  Birth: <%= petFound[key] %></h4>
        <% }else{ %>
            <h4><%=key[0].toUpperCase() + key.slice(1)%> : <%=petFound[key][0].toUpperCase() + petFound[key].slice(1) %></h4>
        <%}%>
        <%}%>
        <% })%>
        
    </div>

    <div>
        <!-- suppose to get user info since they signed in, and then save their username into database for application -->
        <h2> Interested in  adopting <%=petFound.Name%>? Apply your interest here!</h2>
        <form action="/pet-profile" method="post">
            <p>Tell the fosters abit about yourself and why you would love to adopt <%=petFound.Name %>!</p>
            <input type="hidden" name="petName" value="<%=petFound.Name%>">
            <textarea name="applyReason" cols="50" rows="5"></textarea> <br><br>
            <button type="submit">Submit</button>
        </form>
    </div>
    <% if (errorMsg){ %>
        <h3 style="color: red;"><<%=errorMsg%></h3>
    <%}%>
    <% if (successMsg){ %>
        <h3 style="color: green;"><%=successMsg%></h3>
    <%}%>
    
    
    
    <%- include('common/footer') %>

</body>
</html>