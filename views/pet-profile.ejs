<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="./style/pet-profile.css">
    <title><%=petFound.name%>'s Profile</title>
</head>
<body>
    <%- include('common/header') %>

    <h2>Pet Profile</h2>
    <div>
        
        <%for(key in petFound){%>
        <% if (key != 'type' && key != 'uid'  && key != 'adopted' && key != "_id" && key != "createdAt" && key != 'updatedAt' && key!=='__v'&& key != 'approved'){%>
        <% if(key == "img") {%>
          <img src="/images/<%=petFound[key]%>.jpg" alt="<%= petFound.name%>">
        <%}else if (key == "name"){%>
            <h2><%= petFound[key] %></h2>
        <%}else if (key == "dob"){%>
            <h4>Date of  Birth: <%= petFound[key] %></h4>
        <%}else if (key == 'createdByAdmin'){%>
            <%if (user.role == "admin"){%>
            <h4>Created by Admin : <%= petFound[key] ? 'Yes' : 'No' %></h4>
            <%}%>
        <%}else if (key == 'personality' ){%>
            <%if (key == []){%>
            <h4><%=key[0].toUpperCase() + key.slice(1)%> : N/A</h4>
            <%}else{%>
            <h4><%=key[0].toUpperCase() + key.slice(1)%> : <%=petFound[key].join(', ')%></h4>
            <%}%>
        <%}else if (petFound[key] == true ){%>
            <%if (key == 'hdbApproved' ){%>
                <h4>HDB Aproved : Yes</h4>
            <%} else{%>
            <h4><%=key[0].toUpperCase() + key.slice(1)%> : Yes</h4>
            <% } %>
        <%}else if (petFound[key] == false ){%>
            <%if (key == 'hdbApproved' ){%>
                <h4>HDB Aproved : No</h4>
            <% }else{ %>
                <h4><%=key[0].toUpperCase() + key.slice(1)%> : No</h4>
            <%}%>
        <%}else if (key == 'activityLevel' ){%>
            <h4>Activity Level : <%= petFound[key][0].toUpperCase() + petFound[key].slice(1) %></h4>
        <%}else if (key == 'experienceLevel' ){%>
            <h4>Experience level recommended : <%= petFound[key][0].toUpperCase() + petFound[key].slice(1) %></h4>
        
        <% }else{ %>
            <h4><%= key[0].toUpperCase() + key.slice(1) %> : <%= petFound[key] ? petFound[key][0].toUpperCase() + petFound[key].slice(1): 'N/A' %></h4>
        <%}%>
        <%}%>
        <% }%>
        
    </div>

    <div>
        <%if(appExist){%>
            <h3>You have already applied for this <%=petFound.name%>!</h3>
        <%}else{%>
        <!-- suppose to get user info since they signed in, and then save their username into database for application -->
        <h2> Interested in  adopting <%=petFound.name%>? Apply your interest here!</h2>
        <form action="/apply-for-pet" method="post">
            <label for="houseType">House Type:</label>
            <select name="houseType" id="houseType">
                <option value="HDB" <%= (userInfo.preferences.housingType === 'HDB') ? 'selected' : '' %>>HDB</option>
                <option value="Condo" <%= (userInfo.preferences.housingType === 'Condo') ? 'selected' : '' %>>Condo</option>
                <option value="Landed" <%= (userInfo.preferences.housingType === 'Landed') ? 'selected' : '' %>>Landed</option>
            </select><br><br>
            <label for="petExperience">Do you have any prior experience with owning a pet?</label>
            <select name="petExperience" id="petExperience">
                <option value="Yes" <%= (userInfo.preferences.experienceLevel !== 'beginner') ? 'selected' : '' %>>Yes</option>
                <option value="No" <%= (userInfo.preferences.experienceLevel === 'intermediate') ? 'selected' : '' %>>No</option>
            </select><br><br>
            <label for="income">What is your monthly income?</label>
            $<input type="number" name="income" min="0"><br><br>
            <label for="contactNo">What is your contact number?</label>
            +65-<input type="tel" pattern="[0-9]{8}" name="contactNo"><br><br>
            <label for="existingPets">Describe the Pets you currently have: (If none, please indicate N.A)</label><br>
            <br><textarea name="existingPets" cols="50" rows="5"></textarea> <br><br>
            <p>Tell the fosters abit about yourself and why you would love to adopt <%=petFound.name %>!</p>
            <input type="hidden" name="petName" value="<%=petFound.name%>">
            <input type="hidden" name="uid" value="<%=user._id%>">
            <input type="hidden" name="pid" value="<%=petFound._id%>">
            <textarea name="applyReason" cols="50" rows="5"></textarea> <br><br>
            <button type="submit">Submit</button>
        </form>
        <%}%>
    </div>
    <% if (errorMsg){ %>
        <h3 style="color: red;"><%=errorMsg%></h3>
    <%}%>
    <% if (successMsg){ %>
        <h3 style="color: green;"><%=successMsg%></h3>
    <%}%>
    
    
    
    <%- include('common/footer') %>

</body>
</html>