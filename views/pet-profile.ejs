<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('common/header') %>

    <h2>Pet Profile</h2>
    <div>
        <%Object.keys(petFound).forEach(key => {%>
        <% if (key != 'type'){%>
        <% if(key == "img") {%>
            <img src="/images/<%=petFound[key] %>.jpg" style="width: 20;height: 20; border-radius: 10%;">
        <%}else if (key == "Name"){%>
            <h2><%= petFound[key] %></h2>
        <% }else{ %>
            <h4><%=key%>: <%= petFound[key] %></h4>
        <%}%>
        <%}%>
        <% })%>
        
    </div>

    <div>
        <!-- suppose to get user info since they signed in, and then save their username into database for application -->
        <h2> Interested in  adopting <%=petFound.Name%>? Apply your interest here!</h2>
        <form>
            <p>Tell the fosters abit about yourself and why you would love to adopt <%=petFound.Name %>!</p>
            <textarea name="fosterReason" cols="50" rows="5"></textarea> <br><br>
            <button type="submit">Submit</button>
        </form>
    </div>
    
    
    
    <%- include('common/footer') %>

</body>
</html>