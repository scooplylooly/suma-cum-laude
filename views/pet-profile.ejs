<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('common/header') %>

    <h2>Pet Profile</h2>
    <div>
        <%Object.keys(petFound).forEach(key => {%>
        <% if (key != 'type'){%>
        <% if(key == "img") {%>
            <img src="/images/<%=petFound[key] %>.jpg">
        <%}else if (key == "Name"){%>
            <h2><%= petFound[key] %></h2>
        <% }else{ %>
            <h3><%=key%>: <%= petFound[key] %></h3>
        <%}%>
        <%}%>
        <% })%>
        
    </div>

    <div>
        <h2> Interested in  adopting <%=petFound.Name%>? Apply your interest here!</h2>
        <form>
            <label>Name: </label>
            <input type="text">
        </form>
    </div>
    
    
    
    <%- include('common/footer') %>

</body>
</html>