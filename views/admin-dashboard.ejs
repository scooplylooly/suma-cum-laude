<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
</head>
<body>
    <h1>Admin Dashboard</h1>
    
    <h2>Stats</h2>
    <table border="1">
        <tr>
            <th>Total Pets</th>
            <th>Total Applications</th>
            <th>Pending Applications</th>
            <th>Total FAQs</th>
            <th>Total Users</th>
        </tr>
        <tr>
            <td><%= totalPets %></td>
            <td><%= totalApplications %></td>
            <td><%= pendingApplications %></td>
            <td><%= totalFaqs %></td>
            <td><%= totalUsers %></td>
        </tr>
    </table>
    
    <h2>Quick Actions</h2>
    <div>
        <a href="/admin/">Manage Pets</a>
        <a href="/admin/listings">Manage Listings</a>
        <a>Manage Applications</a>
        <a href="/admin/faq">Manage FAQs</a>
        <a href="/admin/users">Manage Users</a>
    </div>

</body>
</html>