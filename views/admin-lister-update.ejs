
<!-- Admin manage Lister Update Page, allows admin to update a lister's details -->


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= userName %>'s</title>
    <link rel="stylesheet" type="text/css" href="/style/lister-style.css">
</head>
<body>
    <%- include('common/header') %>
    <main class="edit-page">
        <div id="form" class="edit-card">
            <form action="/admin/lister-update" class="edit-form" method="post">
                <h2>Please update <%=userName%> lister details.</h2>
                <input type="hidden" name="lid" value="<%=lid%>">
                Address: <input type="text" name="address" value="<%= address %>"> <br>
                Contact number: <input type="number" name="contactNo" value="<%= contactNo %>"> <br>
                Current pet(s) owned: <input type="text" name="pets" value="<%= currentPets %>"> <br>
                Experience with adoption: <input type="text" name="experience" value="<%= experience %>"> <br>
                

                <button type="submit">Update</button>
            </form>
            </div> <br>
            <% if (errors.length > 0) { %>
               <ul class="error-list">
                <% errors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
               </ul>
           <% } %>
        </div>
    </main>
    <%- include('common/footer') %>

    <script>
        function togglePassword(passwordField) {
        const input = document.getElementById(passwordField);
        const icon = document.getElementById(passwordField + '-icon')

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        }
    }
    </script>
</body>
</html>