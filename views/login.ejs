<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in</title>
    <link rel="stylesheet" type="text/css" href="./style/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>
<body>
    <header>
        <h1>Placeholder Title</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/register">Register</a>
        </nav>
    </header>
    
    <main class="login-page">
        <div id="form" class="login-card">
            <h2>Welcome!</h2>
            <p class="subtitle">Log in to find your companion!</p>
            <form action="/login" method="post" class="login-form">
                Username: <input type="text" name="userName" value="<%= userName %>"> <br>
                Password: 
                <div class="password-wrapper">
                    <input type="password" id="password" name="password" value="<%= password %>" >
                    <span class="eye-icon" onclick="togglePassword('password')">
                        <i class="fa-regular fa-eye-slash" id="password-icon"></i>
                    </span>
                </div> <br><br>
                <button type="submit">Log in</button>
            </form>
            <br>

            <p class="links">
                <a href="/forget-password">Forget your password?</a> <br><br>
                Don't have an account?
                <a href="/register" class="register-link">Create an account</a>
            </p>

            <% if (errors.length > 0){ %>
            <ul class="error-list">
                <% errors.forEach(error => { %>
                    <li><%- error %></li>
            <% }) %>
            </ul>
        <% }; %>
            <% if (success) { %>
            <p class="success-message">
            Successful login. <br>
            Time to find your dream companion / BFF!
            </p>
            <script>
                setTimeout(() => {
                    window.location.href = "/adopt";
                },1000)
            </script>
        <% } %>
        </div>

    </main>
    <%- include('common/footer') %>

    <script>
        function togglePassword(passwordField) {
        const input = document.getElementById(passwordField);
        const icon = document.getElementById(passwordField + '-icon')

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        }
    }
    </script>
</body>
</html>