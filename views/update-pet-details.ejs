<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update <%= pet.name %> details</title>
    <link rel="stylesheet" href="/style/create-listing.css">
</head>

<body>
    <%- include('common/header') %>

    <main class="create-listing-page">

        <section class="page-hero">
            <h2>Update Pet Listing</h2>
            <p>Edit your pet’s details below.</p>
        </section>

        <form action="/update-pet" method="post" enctype="multipart/form-data" class="listing-form">
            <input type="hidden" name="pid" value="<%= pet._id %>">

            <!-- TYPE -->
            <div class="form-group">
                <label>Type of Pet:</label>
                <select name="type">
                    <option hidden>--Choose a type--</option>
                    <option value="dog" <%= pet.type == 'dog' ? 'selected' : '' %>>Dog</option>
                    <option value="cat" <%= pet.type == 'cat' ? 'selected' : '' %>>Cat</option>
                    <option value="guinea pig" <%= pet.type == 'guinea pig' ? 'selected' : '' %>>Guinea Pig</option>
                    <option value="bird" <%= pet.type == 'bird' ? 'selected' : '' %>>Bird</option>
                    <option value="rabbit" <%= pet.type == 'rabbit' ? 'selected' : '' %>>Rabbit</option>
                    <option value="hamster" <%= pet.type == 'hamster' ? 'selected' : '' %>>Hamster</option>
                    <option value="other" <%= pet.type == 'other' ? 'selected' : '' %>>Other</option>
                </select>
            </div>

            <!-- IMAGE -->
            <div class="form-group">
                <label>Select image to upload:</label>
                <input type="file" name="image" accept="image/*">
            </div>

            <!-- NAME -->
            <div class="form-group">
                <label>Name:</label>
                <input type="text" name="name" value="<%= pet.name %>">
            </div>

            <!-- BREED -->
            <div class="form-group">
                <label>Breed:</label>
                <input type="text" name="breed" value="<%= pet.breed %>">
            </div>

            <!-- GENDER -->
            <div class="form-group">
                <label>Gender:</label>
                <div class="radio-group">
                    <label class="choice">
                        <input type="radio" name="gender" value="male"
                        <%= pet.gender == 'male' ? 'checked' : '' %>> Male
                    </label>

                    <label class="choice">
                        <input type="radio" name="gender" value="female"
                        <%= pet.gender == 'female' ? 'checked' : '' %>> Female
                    </label>
                </div>
            </div>

            <!-- PERSONALITY -->
            <div class="form-group full-width">
                <label>Their personality:</label>
                <div class="checkbox-group">
                    <% for (let per of petPersonalities) { %>
                        <label class="choice">
                            <input type="checkbox" name="personality" value="<%= per %>"
                            <%= pet.personality.includes(per.toLowerCase()) ? 'checked' : '' %>>
                            <%= per[0].toUpperCase() + per.slice(1) %>
                        </label>
                    <% } %>
                </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="form-group full-width">
                <label>Description:</label>
                <textarea name="desc"><%= pet.description %></textarea>
            </div>

            <!-- DOB -->
            <div class="form-group">
                <label>Date of Birth:</label>
                <input type="date" name="dob" value="<%= pet.dob %>">
            </div>

            <!-- HDB -->
            <div class="form-group">
                <label>HDB Approved?</label>
                <div class="radio-group">
                    <label class="choice">
                        <input type="radio" name="hdbApproved" value="true"
                        <%= pet.hdbApproved ? 'checked' : '' %>> Yes
                    </label>

                    <label class="choice">
                        <input type="radio" name="hdbApproved" value="false"
                        <%= !pet.hdbApproved ? 'checked' : '' %>> No
                    </label>
                </div>
            </div>

            <!-- VACCINATED -->
            <div class="form-group">
                <label>Vaccinated?</label>
                <div class="radio-group">
                    <label class="choice">
                        <input type="radio" name="vaccinated" value="true"
                        <%= pet.vaccinated ? 'checked' : '' %>> Yes
                    </label>

                    <label class="choice">
                        <input type="radio" name="vaccinated" value="false"
                        <%= !pet.vaccinated ? 'checked' : '' %>> No
                    </label>
                </div>
            </div>

            <!-- STERILIZED -->
            <div class="form-group">
                <label>Sterilized?</label>
                <div class="radio-group">
                    <label class="choice">
                        <input type="radio" name="sterilized" value="true"
                        <%= pet.sterilized ? 'checked' : '' %>> Yes
                    </label>

                    <label class="choice">
                        <input type="radio" name="sterilized" value="false"
                        <%= !pet.sterilized ? 'checked' : '' %>> No
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit">Update</button>
            </div>

        </form>

        <!-- ERROR -->
        <% if (errorMsg) { %>
            <h3 class="message error"><%= errorMsg %></h3>
        <% } %>

        <!-- SUCCESS -->
        <% if (successMsg) { %>
            <h3 class="message success"><%= successMsg %> Redirecting...</h3>

            <script>
                setTimeout(() => {
                    window.location.href = "/view-listings";
                }, 3000);
            </script>
        <% } %>

    </main>

    <%- include('common/footer') %>
</body>
</html>