<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" type="text/css" href="./style/new-password.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
     <%- include('common/header') %>

    <main class="reset-page">
        <div class="reset-card">
            <h3>Set a new password</h3>
            <form action="/reset-password" class="reset-form" method="post">
                New Password: 
                <div class="password-wrapper">
                    <input type="password" id="password" name="password" value="<%= password %>">
                    <span class="eye-icon" onclick="togglePassword('password')">
                        <i class="fa-regular fa-eye-slash" id="password-icon"></i>
                    </span>
                </div> <br><br>

                 Confirm New Password: 
                <div class="password-wrapper">
                   <input type="password" id="password2" name="password2" value="<%= password2 %>">
                    <span class="eye-icon" onclick="togglePassword('password2')">
                        <i class="fa-regular fa-eye-slash" id="password2-icon"></i>
                    </span>
                </div>
               <button type="submit" class="reset-link">Reset Password</button>
            </form>

            <% if (errors.length > 0){ %>
            <ul class="error-list">
                <% errors.forEach(error => { %>
                    <li><%- error %></li>
            <% }) %>
            </ul>
            <% } %>

            <% if (success) { %>
            <p class="success-message">
            Successfully resetted password. <br>
            Redirecting to login page...
            </p>
            <script>
                setTimeout(() => {
                    window.location.href = "/login";
                },1000)
            </script>
        <% } %>
        </div>

    </main>
    <%- include('common/footer') %>

    <script>
        function togglePassword(passwordField) {
        const input = document.getElementById(passwordField);
        const icon = document.getElementById(passwordField + '-icon')

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        }
    }
    </script>
</body>
</html>