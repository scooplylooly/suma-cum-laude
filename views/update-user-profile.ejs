<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.userName %>'s</title>
    <link rel="stylesheet" type="text/css" href="./style/update-profile.css">
</head>
<body>
    <!--form for user to update their profile details-->
    <!--dynamic data handling here; boxes will display their default profile details other than password-->
    <%- include('common/header') %>
    <main class="edit-page">
        <div id="form" class="edit-card">
            <form action="/edit-profile" class="edit-form" method="post">
                <h2>Please update your details.</h2>
                Username: <input type="text" name="userName" value="<%= userName %>"> <br>
                Email: <input type="text" name="email" value="<%= email %>"> <br>
                DOB: <input type="date" name="dob" value="<%= DOB %>"> <br>
                
                Update Password:
                <div class="password-wrapper">
                    <input type="password" id="password" name="password" value="<%= password %>" >
                    <span class="eye-icon" onclick="togglePassword('password')">
                        <i class="fa-regular fa-eye-slash" id="password-icon"></i>
                    </span>
                </div> <br>

                 Confirm password: 
                <div class="password-wrapper">
                   <input type="password" id="password2" name="password2" value="<%= password2 %>" >
                    <span class="eye-icon" onclick="togglePassword('password2')">
                        <i class="fa-regular fa-eye-slash" id="password2-icon"></i>
                    </span> 
                </div> <br>

                Update Security Key: What is your dream pet?
                <input type="text" name="securityKey" value="<%= securityKey %>"> <br><br>

                <button type="submit">Update</button>

            </form>
            <!--displays the input errors identified-->
            <% if (errors.length > 0) { %>
               <ul class="error-list">
                <% errors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
               </ul>
           <% } %>
        </div>
    </main>
    <%- include('common/footer') %>

    <script>
        function togglePassword(passwordField) {
        const input = document.getElementById(passwordField);
        const icon = document.getElementById(passwordField + '-icon')

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        }
    }
    </script>
</body>
</html>