<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration</title>
    <link rel="stylesheet" type="text/css" href="./style/register.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>
<body>

    <header>
         <h1>WeADopt!</h1>
        <nav>
            <a href="/index.html">Home</a>
            <a href="/login">Login</a>
        </nav>
    </header>

    <main class="register-page">
        <div id="form" class="register-card">
            <h2>User Registration</h2>
            <%if (user && user.role == 'admin'){%>
                <p class="subtitle">As an admin, you can create accounts for users, listers, and other admins.</p>
            <%}else{%>
                <p class="subtitle">Please create an account to use our services.</p>
            <%}%>
            <form action="/register" method="post" class="register-form">
                User Name: <input type="text" name="userName" value="<%= userName %>"> <br><br>
                Email: <input type="email" name="email" value="<%= email %>"> <br><br>
                DOB: <input type="date" name="dob" value="<%= DOB %>"> <br><br>
                Password: 
                <div class="password-wrapper">
                    <input type="password" id="password" name="password" value="<%= password %>" >
                    <span class="eye-icon" onclick="togglePassword('password')">
                        <i class="fa-regular fa-eye-slash" id="password-icon"></i>
                    </span>
                </div> <br><br>

                 Confirm your password: 
                <div class="password-wrapper">
                   <input type="password" id="password2" name="password2" value="<%= password2 %>" >
                    <span class="eye-icon" onclick="togglePassword('password2')">
                        <i class="fa-regular fa-eye-slash" id="password2-icon"></i>
                    </span>
                </div> <br><br>
                
                 Security Question: <input type="text" name="securityKey" placeholder="What is your dream pet?" value="<%= securityKey %>">
                 
                <%if (user && user.role == 'admin'){%>
                    <br>role:<br>
                    <select name="role" required>
                        <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option>
                        <option value="lister" <%= role === 'lister' ? 'selected' : '' %>>Lister</option>
                        <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                <%}%><br><br>
                <button type="submit" class="register-link">Register</button> <br><br>
            </form>
        <%if (!user || user.role != 'admin'){%>
            <p>Already have an account? <a href="/login" class="login-link">Login here</a></p>
        <%}%>

            <% if (errors.length > 0){ %>
                <ul class="error-list">
                    <% errors.forEach(error => { %>
                    <li><%- error %></li>
                <% }); %>
                </ul>
        <% } %>
            <% if(success){ %>
                <p class="success-message">
                    Thank you for your registration. <br>
                    Please login before exploring your companion options. <br>
                    Redirecting to login page...
                </p>

                <script>
                    setTimeout(()=> {
                        window.location.href = "/login";
                    }, 1000)
                </script>
                
            <% } %>
            
        </div>
    </main>
    <%- include('common/footer') %>

    <script>
        function togglePassword(passwordField) {
        const input = document.getElementById(passwordField);
        const icon = document.getElementById(passwordField + '-icon')

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        }
    }
    </script>
</body>
</html>