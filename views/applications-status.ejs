<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('common/header') %>
    <h1><%=user.userName%>'s Applications:</h1>
    <div>
    <%for (application of applications) {%>
        <h3>Application Number: <%=application.applicationNumber%></h3>
        <h3>Pet Name: <%=application.petName%></h3>
        <h3>Reason: <%=application.reason%></h3>
        <h3>Status: <%=application.status%></h3>
        <h3>Housing Type: <%=application.houseType%></h3>
        <h3>Monthly Income: <%=application.income%></h3>
        <h3>Prior Pet Experience: <%=application.petExperience%></h3>
        <h3>Existing Pets: <%=application.existingPets%></h3>
        <h3>Contact No: +65-<%=application.contactNo%></h3>
        <%if (application.status != 'denied'){%>
        <a href="/pet-profile?pid=<%=application.pid%>"><button>View Pet</button></a>
        <%}%>
        <%if (application.status == 'pending'){%>
        <a href="/updateApplication?appID=<%=application._id%>"><button>Update Application</button></a>
        <%}%>
        <a href="/deleteApplication?appID=<%=application._id%>"><button>Delete Application</button></a>
    <%}%>
    </div>
</body>
</html>