<!-- Pet Profile Page, let users view pet profile and apply for adoption -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="./style/search-pet.css">
    <title>Adopt Now</title>

</head>
<body>
    <%- include('common/header') %>
    <h3>Welcome <%=user.userName%>!</h3>
    <!-- Searchbar code (Finds names of pets according to what was searched)-->
    <form action="/search" method="get">
        <p>Start searching for your dream pet!</p>
        <input type="text" name="nameSearched" id="nameSearch" style="width:90%" placeholder="Search..." value="<%=nameSearched%>">
        <button type="submit">Search</button>
    </form>
    <!--Search Logic-->
   
    <!-- pets lisings-->
    <section>
    <%if(pets.length > 0){%>
    <h2>Adoption Listings</h2>
    <div class="container-flex">
    <%for(let pet of pets){%>
        <%if (pet.approved){%>
        <div class="item"> 
        <img src="/images/<%=pet.img %>.jpg" style="width: 150px; height: 150px; object-fit: cover; border-radius: 10px;" alt="<%= pet.Name%>">
            <h4><%=pet.name%></h4>
            <%if (pet.score !== null){%>
                <h5><b>Match:</b> <%=pet.score%>%</h5>
            <%}%>
            <h5><b>Breed:</b> <%=pet.breed[0].toUpperCase() + pet.breed.slice(1)%></h5>
            <h5><b>Date Of Birth:</b> <%=pet.dob%></h5>
            <% const isOwner = user && String(user._id) === String(pet.uid); %>
            <% const hasApplied = Array.isArray(pids) && pids.includes(String(pet._id)); %>
            <%if (!pet.adopted && !isOwner && !hasApplied) {%>
                <a href="/pet-profile?pid=<%=pet._id%>"><button>Adopt Now</button></a> <br><br>
            <% } else if (pet.adopted) { %>
                <p class="status adopted">Adopted</p>
            
            <% } else if (isOwner) { %>
                <a href="/view-applications?pid=<%=pet._id%>"><button>View Applications</button></a>
            <% } else if (hasApplied) { %>
                <a href="/application-status"><button>View Application Status</button></a>
            <% } %>
        </div>
    <%}%>
  
        <%}%>
        
    <%} else { %>
        <p>No pets found matching your search criteria.</p>
    <% } %>
    </div>
    </section>
    <%- include('common/footer') %>
   
</body>
</html>
