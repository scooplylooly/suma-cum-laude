
<!-- Admin Lister Status Page -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lister Status</title>
    <link rel="stylesheet" href="/style/lister-style.css">
</head>
<body>
    <%- include('common/header') %>

    <main class="status-page">
        <form action="/admin/lister-status" method="post">
            <h2>Pending Lister Applications</h2>
            <%if (!pending || pending.length === 0) {%>
                <p>No pending applications.</p>
            <%} else {%>
                <ul>
                    <%pending.forEach((lister, index) => {%>
                        <li>
                            <h4><%= lister.userName %></h4>
                            <p><span>Address</span>: <%= lister.address %></p>
                            <p><span>Contact number:</span> <%= lister.contactNo %></p>
                            <p><span>Reason of becoming a lister:</span> <%= lister.reason %></p>
                            <p><span>Current pet(s) owned</span>: <%= lister.pets %></p>
                            <p><span>Experience with adoptions:</span> <%= lister.experience %></p>
                            <p><span>Current status:</span> <%= lister.statusL %></p>

                            <input type="hidden" name="listers[<%= index %>][lid]" value="<%= lister._id%>">
                            <input type="hidden" name="listers[<%= index %>][uid]" value="<%= lister.uid%>">
                            <input type="radio" name="listers[<%= index %>][statusL]" value="pending" <%= lister.statusL === 'pending' ? 'checked' : ''%>>
                            <label>Pending</label>
                            <input type="radio" name="listers[<%= index %>][statusL]" value="approved" <%= lister.statusL === 'approved' ? 'checked' : ''%>>
                            <label>Approved</label>
                            <input type="radio" name="listers[<%= index %>][statusL]" value="rejected" <%= lister.statusL === 'rejected' ? 'checked' : ''%>>
                            <label>Rejected</label>
                        </li>
                    <%})%>
                </ul>
                <button type="submit">Update all status</button>

            <%}%>
        </form>

    </main>

    <%- include('common/footer') %>
</body>
</html>